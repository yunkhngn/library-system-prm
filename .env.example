# ==============================================================================
# Library Check-in System - Environment Variables Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_123456
JWT_EXPIRATION=86400000

# Connection to AI Service from Backend
AI_SERVICE_URL=http://ai-service:8001

# --- Python FastAPI AI Service ---
AI_SERVICE_PORT=8001
FACE_SIMILARITY_THRESHOLD=0.65

# --- Flutter Client ---
CLIENT_PORT=3000
API_BASE_URL=http://localhost:8080
