# ==============================================================================
# Library Check-in System - Environment Variables Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# --- Database (PostgreSQL with pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_123456
JWT_EXPIRATION=86400000
DEV_SEED_PASSWORD=dev_secret_password_123

# --- Backend to AI Service Connection ---
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_KEY=dev_ai_internal_service_key_change_in_prod

# --- Python FastAPI AI Service ---
AI_SERVICE_PORT=8001
AI_MOCK_MODE=true
AI_MODELS_READY=false
FACE_SIMILARITY_THRESHOLD=0.65
AI_FACE_MODEL_VERSION=arcface-512-v1

# --- Frontend / Mobile Development ---
# For web/browser: http://localhost:8080
# For Android Emulator: http://10.0.2.2:8080
# For physical mobile device: http://<LAN_IP>:8080
CLIENT_PORT=3000
API_BASE_URL=http://localhost:8080
